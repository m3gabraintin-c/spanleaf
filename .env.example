# Copy this file to .env.local and fill it in. Never commit .env.local.
# You create the Supabase and Resend accounts yourself and paste the keys here.

# ---- which data layer the browser uses ------------------------------------------------------
# Leave unset to run on fake, in-browser data (no accounts needed). Set to "api" for the real backend.
NEXT_PUBLIC_DATA_LAYER=api

# ---- Supabase (Project settings > API, and > Database) -----------------------------------------
# Safe to expose to the browser:
NEXT_PUBLIC_SUPABASE_URL=
# Called the "anon" key or the "publishable" key, depending on your dashboard version.
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# SECRET. Server only. Never prefix with NEXT_PUBLIC_. Bypasses all access rules.
SUPABASE_SERVICE_ROLE_KEY=
# SECRET. Use the "Transaction pooler" connection string (port 6543) for the app,
# and the direct connection string (port 5432) when you run db:migrate.
DATABASE_URL=

# ---- the app itself -----------------------------------------------------------------------------
# Public address of this app, no trailing slash. Used for sign-in redirects.
APP_URL=http://localhost:3000
# SECRET. At least 16 random characters. Vercel Cron sends it automatically when it's set.
CRON_SECRET=

# ---- AI composer ---------------------------------------------------------------------------------
# SECRET. Lets the composer look at photos and pick colours, captions and a style. Leave empty to
# run without it: carousels still get made, with plain defaults.
ANTHROPIC_API_KEY=
# Which model looks at the photos. Defaults to claude-sonnet-5-5.
COMPOSE_MODEL=

# ---- optional -----------------------------------------------------------------------------------
# Show the "Continue with Google" button. Needs your own Google OAuth app set up in Supabase.
NEXT_PUBLIC_GOOGLE_AUTH=
